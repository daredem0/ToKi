{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/tokkiclient/toki/schemas/map.json",
  "title": "ToKi Tilemap",
  "description": "A tilemap definition containing tile layout and metadata for the ToKi game engine",
  "type": "object",
  "required": ["size", "tile_size", "atlas"],
  "oneOf": [
    {"required": ["tiles"]},
    {"required": ["layers"]}
  ],
  "properties": {
    "size": {
      "type": "array",
      "items": {"type": "integer", "minimum": 1},
      "minItems": 2,
      "maxItems": 2,
      "description": "Size of the map in tiles [width, height]"
    },
    "tile_size": {
      "type": "array",
      "items": {"type": "integer", "minimum": 1},
      "minItems": 2,
      "maxItems": 2,
      "description": "Size of each tile [width, height] in pixels"
    },
    "atlas": {
      "type": "string",
      "description": "Name of the atlas file containing the tiles"
    },
    "tiles": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Legacy: flat array of tile names (single layer). Use 'layers' for multi-layer maps."
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "description": "Ordered list of tile layers, rendered bottom-to-top",
      "items": {
        "type": "object",
        "required": ["name", "tiles"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Layer name (e.g. 'ground', 'detail', 'above')"
          },
          "tiles": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Row-major flat array of tile names for this layer"
          },
          "visible": {
            "type": "boolean",
            "default": true,
            "description": "Whether this layer is rendered"
          },
          "collision_enabled": {
            "type": "boolean",
            "default": true,
            "description": "Whether this layer participates in collision checks"
          },
          "above_entities": {
            "type": "boolean",
            "default": false,
            "description": "When true, this layer renders above entity sprites"
          }
        }
      }
    },
    "objects": {
      "type": "array",
      "description": "Optional placed object instances stored directly on the map asset",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sheet", "object_name", "position"],
        "properties": {
          "sheet": {
            "type": "string",
            "minLength": 1
          },
          "object_name": {
            "type": "string",
            "minLength": 1
          },
          "position": {
            "type": "array",
            "items": {"type": "integer", "minimum": 0},
            "minItems": 2,
            "maxItems": 2
          },
          "size_px": {
            "type": "array",
            "items": {"type": "integer", "minimum": 1},
            "minItems": 2,
            "maxItems": 2
          },
          "visible": {
            "type": "boolean"
          },
          "solid": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
