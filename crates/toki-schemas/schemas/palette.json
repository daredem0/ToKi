{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ToKi Palette Asset",
  "type": "object",
  "additionalProperties": false,
  "required": ["colors"],
  "properties": {
    "colors": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "array",
        "minItems": 4,
        "maxItems": 4,
        "items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      }
    }
  }
}
